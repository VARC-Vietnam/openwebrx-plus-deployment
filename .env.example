# Generated by install.sh — copy to .env or re-run ./install.sh

# Docker image: slechev/openwebrxplus or slechev/openwebrxplus-softmbe
OWRX_IMAGE=slechev/openwebrxplus:latest
OWRX_CONTAINER_NAME=openwebrxplus

# Web UI
OWRX_PORT=8073
TZ=UTC

# Admin account (created on first start if set)
OPENWEBRX_ADMIN_USER=admin
OPENWEBRX_ADMIN_PASSWORD=changeme

# Data root on the Debian host (official docs use /opt/owrx-docker)
OWRX_DATA_DIR=/opt/owrx-docker

# Selected SDR family: rtl_sdr | rx888
OWRX_DEVICE=rtl_sdr

# Access mode
# BIND_USB=true  → mount /dev/bus/usb, OpenWebRX type rtl_sdr (or sddc_soapy)
# RTL_TCP_CLIENT=true → no USB mount; OpenWebRX type rtl_tcp → RTL_TCP_REMOTE
BIND_USB=true
RTL_TCP_CLIENT=false
RTL_TCP_REMOTE=

# Optional: publish rtl_tcp-compatible IQ tap FROM a USB device in the container.
# (Not used when RTL_TCP_CLIENT=true.) Internal port must differ from external.
FORWARD_LOCALPORT_INTERNAL=
FORWARD_RTL_TCP_EXTERNAL=
ENABLE_RTL_TCP=false

# Health checks (USB vendor_product = count)
# RTL-SDR Blog / generic: 0BDA:2838 or 0BDA:2832
# RX-888 / SDDC: 04B4:00F1 or 04B4:00F3
HEALTHCHECK_USB=
HEALTHCHECK_SDR_DEVICES=1
